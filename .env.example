ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PEOPLE_BASE_URL=https://people.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_EMPLOYEE_FORM=employee
